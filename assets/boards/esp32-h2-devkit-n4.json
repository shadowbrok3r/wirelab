  "specs": [
    "32-bit RISC-V single-core @ 96 MHz",
    "Bluetooth LE 5 (no Wi-Fi)",
    "802.15.4 (Zigbee / Thread)",
    "320 KB SRAM, 128 KB ROM, 4 KB LP memory",
    "4 MB flash (N4)",
    "12-bit ADC (5 ch), LED PWM, RMT, TWAI",
    "USB Serial/JTAG + CH343 UART via CH334 hub",
    "BOOT button on GPIO9, WS2812 RGB LED on GPIO8"
  ],
